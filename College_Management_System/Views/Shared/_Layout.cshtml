<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Nexora Institute of Science &amp; Technology</title>
    <meta name="description"
          content="Nexora Institute of Science &amp; Technology: academic excellence, innovation and career readiness.">
    <script>document.documentElement.classList.add('js');</script>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,600;0,700;0,800;1,600&display=swap"
          rel="stylesheet">

    <!-- Bootstrap 5 + Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    @* <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" /> *@
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
    
    <link rel="stylesheet" href="~/College_Management_System.styles.css" asp-append-version="true" />
</head>
<body>
    <!-- ================= HEADER ================= -->
    <header class="site-header sticky-top bg-white">
        <nav class="navbar navbar-expand-lg py-2">
            <div class="container-fluid">

                <a href="@Url.Action("Index", "Home")" class="navbar-brand d-flex align-items-center gap-2 gap-sm-3 py-0 me-3" href="index.html"
                   aria-label="Nexora Institute of Science and Technology, home">
                    <svg class="logo flex-shrink-0" viewBox="0 0 120 124" role="img" aria-label="Nexora crest">
                        <g id="nx-crest">
                            <g id="laurel" fill="#D9A22B">
                                <ellipse cx="20" cy="94" rx="4" ry="9" transform="rotate(-35 20 94)" />
                                <ellipse cx="13" cy="80" rx="4" ry="9" transform="rotate(-18 13 80)" />
                                <ellipse cx="10" cy="65" rx="4" ry="9" />
                                <ellipse cx="11" cy="50" rx="4" ry="9" transform="rotate(12 11 50)" />
                                <ellipse cx="16" cy="36" rx="4" ry="9" transform="rotate(28 16 36)" />
                                <ellipse cx="25" cy="24" rx="4" ry="9" transform="rotate(45 25 24)" />
                            </g>
                            <use href="#laurel" transform="translate(120 0) scale(-1 1)" />
                            <path d="M60 12 L98 22 V64 C98 88 80 102 60 112 C40 102 22 88 22 64 V22 Z" fill="#0B2A5B" stroke="#D9A22B"
                                  stroke-width="3" />
                            <path class="flame"
                                  d="M60 24 C54 32 51 38 55 45 C51 44 48 40 49 35 C45 41 45 49 51 53 C57 57 66 55 68 47 C70 41 66 35 62 31 C62 35 60 37 58 37 C60 33 62 29 60 24 Z"
                                  fill="#F2B233" />
                            <rect x="57" y="54" width="6" height="12" rx="1" fill="#D9A22B" />
                            <path d="M60 70 C50 64 40 64 31 67 V91 C40 88 50 88 60 94 Z" fill="#FFFFFF" />
                            <path d="M60 70 C70 64 80 64 89 67 V91 C80 88 70 88 60 94 Z" fill="#E7ECF6" />
                            <path d="M60 70 V94" stroke="#0B2A5B" stroke-width="1.5" />
                            <polygon points="60,0 62.2,5.5 68,5.9 63.5,9.6 65,15.2 60,12 55,15.2 56.5,9.6 52,5.9 57.8,5.5"
                                     fill="#D9A22B" />
                        </g>
                    </svg>
                    <span class="d-flex flex-column">
                        <span class="brand-name">NEXORA</span>
                        <span class="brand-sub">Institute of Science &amp; Technology</span>
                        <span class="brand-tag d-none d-md-block">Learn &bull; Grow &bull; Build Tomorrow</span>
                    </span>
                </a>

                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse"
                        data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle menu">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav ms-lg-auto align-items-lg-center gap-lg-1 pt-3 pt-lg-0">
                        <li class="nav-item"><a class="nav-link active" href="@Url.Action("Index","Home")" aria-current="page">Home</a></li>
                        <li class="nav-item"><a class="nav-link" href="@Url.Action("About", "Home")">About Us</a></li>
                        <li class="nav-item"><a class="nav-link" href="about.html#programs">Programs</a></li>
                        <li class="nav-item"><a class="nav-link" href="@Url.Action("Services", "Home")">Services</a></li>
                        <li class="nav-item"><a class="nav-link" href="@Url.Action("Contact", "Home")">Contact</a></li>
                        <li class="nav-item ms-lg-3 mt-3 mt-lg-0 pb-3 pb-lg-0">
                            <a class="btn btn-warning btn-shine fw-semibold px-4" asp-action="Index" asp-controller="Home" asp-fragment="portal">Portal Login</a>
                        </li>
                    </ul>
                </div>

            </div>
        </nav>
    </header>
    <div class="">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- ================= FOOTER ================= -->
    <footer class="site-footer text-white">
        <div class="container py-5">
            <div class="row g-4">
                <div class="col-lg-4">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <span class="footer-mark d-inline-flex align-items-center justify-content-center">
                            <i class="bi bi-mortarboard-fill"></i>
                        </span>
                        <div class="lh-1">
                            <div class="brand-name text-white fs-3">NEXORA</div>
                            <div class="small text-uppercase footer-sub mt-1">Institute of Science &amp; Technology</div>
                        </div>
                    </div>
                    <p class="small text-white-50 mb-3">
                        Empowering Minds. Building Futures. A learning community focused on
                        academic excellence, innovation and career readiness.
                    </p>
                    <div class="d-flex gap-2">
                        <a class="social" href="#" aria-label="Facebook"><i class="bi bi-facebook"></i></a>
                        <a class="social" href="#" aria-label="Instagram"><i class="bi bi-instagram"></i></a>
                        <a class="social" href="#" aria-label="LinkedIn"><i class="bi bi-linkedin"></i></a>
                        <a class="social" href="#" aria-label="YouTube"><i class="bi bi-youtube"></i></a>
                    </div>
                </div>
                <div class="col-6 col-lg-2">
                    <h2 class="h6 text-gold text-uppercase mb-3">Quick links</h2>
                    <ul class="list-unstyled small d-grid gap-2 mb-0">
                        <li><a class="foot-link" href="index.html">Home</a></li>
                        <li><a class="foot-link" href="about.html">About Us</a></li>
                        <li><a class="foot-link" href="about.html#programs">Programs</a></li>
                        <li><a class="foot-link" href="services.html">Services</a></li>
                        <li><a class="foot-link" href="contact.html">Contact</a></li>
                    </ul>
                </div>
                <div class="col-6 col-lg-2">
                    <h2 class="h6 text-gold text-uppercase mb-3">Portals</h2>
                    <ul class="list-unstyled small d-grid gap-2 mb-0">
                        <li><a class="foot-link" href="index.html#portal">Student</a></li>
                        <li><a class="foot-link" href="index.html#portal">Teacher</a></li>
                        <li><a class="foot-link" href="index.html#portal">Parent</a></li>
                        <li><a class="foot-link" href="index.html#portal">Admin</a></li>
                    </ul>
                </div>
                <div class="col-lg-4">
                    <h2 class="h6 text-gold text-uppercase mb-3">Contact</h2>
                    <ul class="list-unstyled small d-grid gap-3 mb-0">
                        <li class="d-flex gap-3">
                            <i class="bi bi-geo-alt text-gold"></i><span>
                            Nexora Institute of Science &amp;
                            Technology<br>Green Valley Campus, 123 Education Road, Shivpur, Bhopal - 462001
                        </span>
                    </li>
                    <li class="d-flex gap-3"><i class="bi bi-envelope text-gold"></i><span>info@nexora.edu.in</span></li>
                    <li class="d-flex gap-3"><i class="bi bi-telephone text-gold"></i><span>+91 98765 43210</span></li>
                </ul>
            </div>
        </div>
    </div>
    <div class="footer-bottom py-3 small text-white-50">
        <div class="container d-flex flex-wrap justify-content-between gap-2">
            <span>&copy; 2026 Nexora Institute of Science &amp; Technology. Demo website.</span>
            <span>Your Campus &bull; Our Responsibility</span>
        </div>
    </div>
</footer>

<button id="toTop" class="btn btn-warning rounded-circle shadow" aria-label="Back to top">
    <i class="bi bi-chevron-up"></i>
</button>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
@* <script src="~/js/site.js" asp-append-version="true"></script> *@
<script src="~/js/script.js" asp-append-version="true"></script>
    @* @await RenderSectionAsync("Scripts", required: false) *@
</body>
</html>
