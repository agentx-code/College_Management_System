@{
    ViewData["Title"] = "About Page";
}


<!-- ================= PAGE BANNER ================= -->
<section class="page-hero text-white position-relative overflow-hidden">
    <img src="~/assets/images/courtyard.webp" alt="Academic block with a green garden walkway" class="page-hero-img position-absolute top-0 start-0 w-100 h-100 object-fit-cover">
    <div class="page-hero-shade position-absolute top-0 start-0 w-100 h-100"></div>
    <div class="container position-relative py-5">
        
        <h1 class="hero-title fade-up d2 mb-2">About Nexora</h1>
        <p class="lead hero-lead fade-up d3 mb-0">Nexora Institute of Science &amp; Technology</p>
    </div>
</section>


<!-- ================= WHO WE ARE ================= -->
<section class="py-5 py-lg-6">
    <div class="container">
        <div class="row gy-5 gx-lg-5 align-items-center">
            <div class="col-lg-6 reveal">
                <p class="eyebrow mb-2">Who we are</p>
                <h2 class="section-title text-navy mb-3">About Nexora Institute of Science &amp; Technology</h2>
                <p class="text-secondary">Nexora Institute of Science &amp; Technology is a proposed higher education institution focused on academic learning, technological advancement, and professional development. Our institutional vision is to create a learning environment where students can develop knowledge, practical skills, critical thinking, and ethical responsibility.</p>
                <a href="@Url.Action("Contact", "Home")" class="btn btn-warning btn-shine fw-semibold px-4 mt-2">Contact Admissions</a>
            </div>
            <div class="col-lg-6 reveal reveal-right">
                <div class="img-stack position-relative">
                    <img src="~/assets/images/building.webp" alt="Red brick college building with a columned entrance and a wide lawn" class="w-100 rounded-4 shadow-lg">
                    <img src="~/assets/images/study.webp" alt="Students studying together on college steps" class="img-stack-small rounded-4 shadow d-none d-sm-block">
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ================= VISION + MISSION ================= -->
<section class="py-5 py-lg-6 bg-white">
    <div class="container">
        <div class="row g-4">
            <div class="col-lg-5">
                <div class="vision-card rounded-4 p-4 p-lg-5 text-white h-100 reveal">
                    <span class="icon-box icon-gold mb-3"><i class="bi bi-eye"></i></span>
                    <h2 class="h3 fw-bold mb-3" style="font-family:'Playfair Display',serif">Our Vision</h2>
                    <p class="mb-0 text-white-50">To build a learning community that encourages innovation, academic excellence, and lifelong learning while preparing students to contribute meaningfully to society.</p>
                </div>
            </div>
            <div class="col-lg-7">
                <div class="mission-card rounded-4 p-4 p-lg-5 h-100 reveal reveal-right">
                    <span class="icon-box mb-3"><i class="bi bi-bullseye"></i></span>
                    <h2 class="h3 fw-bold text-navy mb-3" style="font-family:'Playfair Display',serif">Our Mission</h2>
                    <ul class="list-unstyled mb-0 text-secondary"><li class="d-flex gap-2 mb-2"><i class="bi bi-check-circle-fill text-gold"></i><span>Provide structured, student-centered learning experiences.</span></li><li class="d-flex gap-2 mb-2"><i class="bi bi-check-circle-fill text-gold"></i><span>Encourage practical learning, research, and creative problem-solving.</span></li><li class="d-flex gap-2 mb-2"><i class="bi bi-check-circle-fill text-gold"></i><span>Promote integrity, collaboration, and professional responsibility.</span></li><li class="d-flex gap-2 mb-2"><i class="bi bi-check-circle-fill text-gold"></i><span>Support students through academic guidance and career development.</span></li><li class="d-flex gap-2 mb-2"><i class="bi bi-check-circle-fill text-gold"></i><span>Use technology to improve educational administration and communication.</span></li></ul>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ================= CORE VALUES ================= -->
<section class="py-5 py-lg-6">
    <div class="container">
        <div class="section-head text-center reveal mb-4 mb-lg-5">
            <p class="eyebrow mb-2">What we stand for</p>
            <h2 class="section-title text-navy">Our Core Values</h2>
        </div>
        <div class="row g-3">
            <div class="col-sm-6 col-lg-4 col-xl">
                <div class="module-card card h-100 text-center reveal" style="--i:0">
                    <div class="card-body p-4">
                        <span class="icon-box mb-3 mx-auto"><i class="bi bi-shield-check"></i></span>
                        <h3 class="h6 fw-bold text-navy">Integrity</h3>
                        <p class="small text-secondary mb-0">Maintain honesty, fairness, and accountability.</p>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-lg-4 col-xl">
                <div class="module-card card h-100 text-center reveal" style="--i:1">
                    <div class="card-body p-4">
                        <span class="icon-box mb-3 mx-auto"><i class="bi bi-lightbulb"></i></span>
                        <h3 class="h6 fw-bold text-navy">Innovation</h3>
                        <p class="small text-secondary mb-0">Encourage curiosity, creativity, and continuous improvement.</p>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-lg-4 col-xl">
                <div class="module-card card h-100 text-center reveal" style="--i:2">
                    <div class="card-body p-4">
                        <span class="icon-box mb-3 mx-auto"><i class="bi bi-award"></i></span>
                        <h3 class="h6 fw-bold text-navy">Excellence</h3>
                        <p class="small text-secondary mb-0">Strive for high standards in teaching, learning, and administration.</p>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-lg-4 col-xl">
                <div class="module-card card h-100 text-center reveal" style="--i:3">
                    <div class="card-body p-4">
                        <span class="icon-box mb-3 mx-auto"><i class="bi bi-people"></i></span>
                        <h3 class="h6 fw-bold text-navy">Inclusivity</h3>
                        <p class="small text-secondary mb-0">Promote a respectful and supportive learning environment.</p>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-lg-4 col-xl">
                <div class="module-card card h-100 text-center reveal" style="--i:4">
                    <div class="card-body p-4">
                        <span class="icon-box mb-3 mx-auto"><i class="bi bi-mortarboard"></i></span>
                        <h3 class="h6 fw-bold text-navy">Student Success</h3>
                        <p class="small text-secondary mb-0">Help learners develop academically, personally, and professionally.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ================= PROGRAMS ================= -->
<section class="py-5 py-lg-6 bg-white" id="programs">
    <div class="container">
        <div class="section-head text-center reveal mb-4 mb-lg-5">
            <p class="eyebrow mb-2">Academic departments and programs</p>
            <h2 class="section-title text-navy">Our Schools</h2>
        </div>
        <div class="row g-4">
            <div class="col-md-6 col-lg-4">
                <div class="school-card card h-100 reveal" style="--i:0">
                    <div class="card-body p-4">
                        <span class="icon-box icon-gold mb-3"><i class="bi bi-cpu"></i></span>
                        <h3 class="h5 fw-bold text-navy">School of Computing and Information Technology</h3>
                        <p class="small fw-semibold text-gold-deep mb-2">Example programs: BCA, B.Sc. Computer Science, MCA</p>
                        <p class="text-secondary mb-0">Develop programming, software development, database management, networking, and problem-solving skills.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="school-card card h-100 reveal" style="--i:1">
                    <div class="card-body p-4">
                        <span class="icon-box icon-gold mb-3"><i class="bi bi-bezier2"></i></span>
                        <h3 class="h5 fw-bold text-navy">School of Science</h3>
                        <p class="small fw-semibold text-gold-deep mb-2">Example programs: B.Sc. Physics, Chemistry, Mathematics</p>
                        <p class="text-secondary mb-0">Build scientific understanding through theoretical study, laboratory practice, and analytical thinking.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="school-card card h-100 reveal" style="--i:2">
                    <div class="card-body p-4">
                        <span class="icon-box icon-gold mb-3"><i class="bi bi-graph-up-arrow"></i></span>
                        <h3 class="h5 fw-bold text-navy">School of Commerce and Management</h3>
                        <p class="small fw-semibold text-gold-deep mb-2">Example programs: B.Com, BBA, MBA</p>
                        <p class="text-secondary mb-0">Learn about accounting, finance, business operations, management, and entrepreneurship.</p>
                    </div>
                </div>
            </div>
        </div>
       
    </div>
</section>

<!-- ================= LIFE AT NEXORA ================= -->
<section class="py-5 py-lg-6">
    <div class="container">
        <div class="section-head reveal mb-4 mb-lg-5">
            <p class="eyebrow mb-2">Life at Nexora</p>
            <h2 class="section-title text-navy">Learning goes beyond the classroom</h2>
        </div>
        <div class="row g-3">
            <div class="col-md-5"><figure class="gallery-tile tall rounded-4 overflow-hidden position-relative m-0 reveal zoom"><img src="~/assets/images/singing.webp" alt="Students playing guitar and flute on a staircase" class="w-100 h-100 object-fit-cover" loading="lazy"><figcaption class="position-absolute bottom-0 start-0 m-2 px-3 py-1 rounded-pill small fw-semibold">Music and culture</figcaption></figure></div>
            <div class="col-md-7">
                <div class="row g-3">
                    <div class="col-12"><figure class="gallery-tile rounded-4 overflow-hidden position-relative m-0 reveal zoom"><img src="~/assets/images/ground.webp" alt="Wide cricket ground surrounded by trees and hills" class="w-100 h-100 object-fit-cover" loading="lazy"><figcaption class="position-absolute bottom-0 start-0 m-2 px-3 py-1 rounded-pill small fw-semibold">Playground</figcaption></figure></div>
                    <div class="col-6"><figure class="gallery-tile rounded-4 overflow-hidden position-relative m-0 reveal zoom"><img src="~/assets/images/volleyball.webp" alt="Students playing volleyball" class="w-100 h-100 object-fit-cover" loading="lazy"><figcaption class="position-absolute bottom-0 start-0 m-2 px-3 py-1 rounded-pill small fw-semibold">Sports</figcaption></figure></div>
                    <div class="col-6"><figure class="gallery-tile rounded-4 overflow-hidden position-relative m-0 reveal zoom"><img src="~/assets/images/lecture.webp" alt="Student writing notes in a lecture hall" class="w-100 h-100 object-fit-cover" loading="lazy"><figcaption class="position-absolute bottom-0 start-0 m-2 px-3 py-1 rounded-pill small fw-semibold">Lecture hall</figcaption></figure></div>
                </div>
            </div>
        </div>
    </div>
</section>