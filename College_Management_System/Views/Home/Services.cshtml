@{
    ViewData["Title"] = "Services Page";
}


<!-- ================= PAGE BANNER ================= -->
<section class="page-hero text-white position-relative overflow-hidden">
    <img src="~/assets/images/lecture.webp" alt="Student taking notes in a tiered lecture hall" class="page-hero-img position-absolute top-0 start-0 w-100 h-100 object-fit-cover">
    <div class="page-hero-shade position-absolute top-0 start-0 w-100 h-100"></div>
    <div class="container position-relative py-5">
        <nav aria-label="breadcrumb" class="fade-up d1">
            <ol class="breadcrumb mb-2 small">
                <li class="breadcrumb-item"><a href="index.html" class="link-light link-underline-opacity-0">Home</a></li>
                <li class="breadcrumb-item active text-gold" aria-current="page">Services</li>
            </ol>
        </nav>
        <h1 class="hero-title fade-up d2 mb-2">Our Services</h1>
        <p class="lead hero-lead fade-up d3 mb-0">Modules of the Nexora College Management System</p>
    </div>
</section>


<!-- ================= SERVICES ================= -->
<section class="py-5 py-lg-6">
    <div class="container">
        <div class="section-head text-center reveal mb-4 mb-lg-5">
            <p class="eyebrow mb-2">What we manage</p>
            <h2 class="section-title text-navy">Everything a college needs, in one place</h2>
        </div>
        <div class="row g-4">
            <div class="col-md-6 col-lg-4" id="admissions">
                <div class="module-card card h-100 reveal" style="--i:0">
                    <div class="card-body p-4">
                        <span class="icon-box mb-3"><i class="bi bi-mortarboard"></i></span>
                        <h3 class="h5 fw-bold text-navy">Admissions Management</h3>
                        <p class="text-secondary mb-0">Manage admission applications, applicant details, document verification, enrollment, and student registration.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-4" id="attendance">
                <div class="module-card card h-100 reveal" style="--i:1">
                    <div class="card-body p-4">
                        <span class="icon-box mb-3"><i class="bi bi-calendar-check"></i></span>
                        <h3 class="h5 fw-bold text-navy">Attendance Management</h3>
                        <p class="text-secondary mb-0">Record daily attendance, monitor attendance percentages, and identify students who need attendance support.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-4" id="exams">
                <div class="module-card card h-100 reveal" style="--i:2">
                    <div class="card-body p-4">
                        <span class="icon-box mb-3"><i class="bi bi-file-earmark-text"></i></span>
                        <h3 class="h5 fw-bold text-navy">Examinations and Results</h3>
                        <p class="text-secondary mb-0">Organize examination schedules, record marks, calculate results, and provide authorized access to academic performance.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-4" id="fees">
                <div class="module-card card h-100 reveal" style="--i:0">
                    <div class="card-body p-4">
                        <span class="icon-box mb-3"><i class="bi bi-currency-rupee"></i></span>
                        <h3 class="h5 fw-bold text-navy">Fees and Payments</h3>
                        <p class="text-secondary mb-0">Maintain fee structures, payment records, outstanding balances, and fee receipts.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-4" id="students">
                <div class="module-card card h-100 reveal" style="--i:1">
                    <div class="card-body p-4">
                        <span class="icon-box mb-3"><i class="bi bi-person-lines-fill"></i></span>
                        <h3 class="h5 fw-bold text-navy">Student and Faculty Management</h3>
                        <p class="text-secondary mb-0">Maintain student profiles, faculty information, department assignments, and authorized account access.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-4" id="campus">
                <div class="module-card card h-100 reveal" style="--i:2">
                    <div class="card-body p-4">
                        <span class="icon-box mb-3"><i class="bi bi-book"></i></span>
                        <h3 class="h5 fw-bold text-navy">Library and Campus Services</h3>
                        <p class="text-secondary mb-0">Track library books, issue and return transactions, hostel allocations, and other campus facilities as implemented.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-4" id="reports">
                <div class="module-card card h-100 reveal" style="--i:0">
                    <div class="card-body p-4">
                        <span class="icon-box mb-3"><i class="bi bi-bar-chart-line"></i></span>
                        <h3 class="h5 fw-bold text-navy">Reports and Analytics</h3>
                        <p class="text-secondary mb-0">Generate summaries of enrollment, attendance, fees, examination results, and other administrative records.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="cta-mini rounded-4 p-4 h-100 text-white d-flex flex-column justify-content-center reveal" style="--i:1">
                    <h3 class="h5 fw-bold">Need help with a service?</h3>
                    <p class="small text-white-50">Our student support team can guide you.</p>
                    <div><a href="@Url.Action("Contact", "Home")" class="btn btn-warning fw-semibold btn-shine">Contact us</a></div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ================= CAMPUS SERVICES PHOTOS ================= -->
<section class="py-5 bg-white">
    <div class="container">
        <div class="row g-4 align-items-center">
            <div class="col-lg-5 reveal">
                <p class="eyebrow mb-2">Campus facilities</p>
                <h2 class="section-title text-navy mb-3">Library, hostel and canteen services</h2>
                <p class="text-secondary mb-0">Track library books, issue and return transactions, hostel allocations, and other campus facilities as implemented.</p>
            </div>
            <div class="col-lg-7">
                <div class="row g-3">
                    <div class="col-6"><figure class="gallery-tile rounded-4 overflow-hidden m-0 reveal zoom"><img src="~/assets/images/canteen-hall.webp" alt="Canteen hall with tables and red chairs" class="w-100 h-100 object-fit-cover" loading="lazy"></figure></div>
                    <div class="col-6"><figure class="gallery-tile rounded-4 overflow-hidden m-0 reveal zoom" style="--i:1"><img src="~/assets/images/cafe.webp" alt="Students at tables in the campus cafe" class="w-100 h-100 object-fit-cover" loading="lazy"></figure></div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ================= DASHBOARDS BY ROLE ================= -->
<section class="py-5 py-lg-6" id="roles">
    <div class="container">
        <div class="section-head text-center reveal mb-4 mb-lg-5">
            <p class="eyebrow mb-2">Dashboards by role</p>
            <h2 class="section-title text-navy">Every user sees what they need</h2>
        </div>
        <div class="row justify-content-center">
            <div class="col-lg-9">
                <div class="bg-white rounded-4 shadow-sm p-3 p-md-4 reveal">
                    <ul class="nav nav-pills role-pills justify-content-center gap-2 mb-4" role="tablist"><li class="nav-item" role="presentation"><button class="nav-link role-tab active" id="tab-admin" data-bs-toggle="pill" data-bs-target="#pane-admin" type="button" role="tab" aria-controls="pane-admin" aria-selected="true"><i class="bi bi-gear-fill me-2"></i>Admin</button></li><li class="nav-item" role="presentation"><button class="nav-link role-tab" id="tab-teacher" data-bs-toggle="pill" data-bs-target="#pane-teacher" type="button" role="tab" aria-controls="pane-teacher" aria-selected="false"><i class="bi bi-person-workspace me-2"></i>Teacher</button></li><li class="nav-item" role="presentation"><button class="nav-link role-tab" id="tab-student" data-bs-toggle="pill" data-bs-target="#pane-student" type="button" role="tab" aria-controls="pane-student" aria-selected="false"><i class="bi bi-mortarboard-fill me-2"></i>Student</button></li><li class="nav-item" role="presentation"><button class="nav-link role-tab" id="tab-parent" data-bs-toggle="pill" data-bs-target="#pane-parent" type="button" role="tab" aria-controls="pane-parent" aria-selected="false"><i class="bi bi-people-fill me-2"></i>Parent</button></li></ul>
                    <div class="tab-content text-center px-md-4 pb-3">
                        <div class="tab-pane fade show active" id="pane-admin" role="tabpanel" aria-labelledby="tab-admin" tabindex="0">
                            <h3 class="h4 fw-bold text-navy mb-2">Admin Dashboard</h3>
                            <p class="lead text-secondary mb-0">Manage users, roles, departments, courses, notices, and system reports.</p>
                        </div>
                        <div class="tab-pane fade" id="pane-teacher" role="tabpanel" aria-labelledby="tab-teacher" tabindex="0">
                            <h3 class="h4 fw-bold text-navy mb-2">Teacher Dashboard</h3>
                            <p class="lead text-secondary mb-0">View assigned classes, mark attendance, enter marks, and manage class information.</p>
                        </div>
                        <div class="tab-pane fade" id="pane-student" role="tabpanel" aria-labelledby="tab-student" tabindex="0">
                            <h3 class="h4 fw-bold text-navy mb-2">Student Dashboard</h3>
                            <p class="lead text-secondary mb-0">View profile, attendance, timetable, results, fee status, and notices.</p>
                        </div>
                        <div class="tab-pane fade" id="pane-parent" role="tabpanel" aria-labelledby="tab-parent" tabindex="0">
                            <h3 class="h4 fw-bold text-navy mb-2">Parent Dashboard</h3>
                            <p class="lead text-secondary mb-0">View linked student's attendance, results, notices, and fee information.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>