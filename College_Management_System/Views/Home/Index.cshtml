                            <div>
                                <div class="stat-num"><span data-count="12">12</span></div>
                                <div class="fw-semibold small">Powerful Modules</div>
                                <div class="stat-sub">Everything in one system</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3 reveal" style="--i:2">
                        <div class="stat">
