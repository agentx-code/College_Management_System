<!-- ================= NOTICES + CTA ================= -->
<section class="py-5 py-lg-6">
    <div class="container">
        <div class="row g-4 align-items-stretch">
            <div class="col-lg-7">
                <div class="bg-white rounded-4 shadow-sm p-4 p-lg-5 h-100 reveal">
                    <h2 class="section-title text-navy mb-3">Notice Board</h2>
                    <ul class="list-unstyled mb-0 notice-list">
                        <li class="notice-item d-flex gap-3 py-3 reveal" style="--i:0">
                            <span class="icon-box icon-sm flex-shrink-0"><i class="bi bi-journal-text"></i></span>
                            <div>
                                <div class="fw-bold text-navy small text-uppercase notice-label">Academic Notice</div>
                                <p class="mb-0 text-secondary">
                                    Semester examination timetable will be published after approval by
                                    the Examination Cell.
                                </p>
