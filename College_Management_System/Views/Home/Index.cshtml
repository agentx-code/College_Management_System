<div class="modal fade" id="loginModal" tabindex="-1" aria-labelledby="loginTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 overflow-hidden">
            <div class="modal-header login-head text-white border-0">
                <h2 class="modal-title h5 fw-bold" id="loginTitle">
                    <i class="bi bi-person-circle me-2"></i><span id="loginRole">Student</span> Login
                </h2>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="loginForm" class="needs-validation" novalidate>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label for="loginId" class="form-label fw-semibold" id="loginIdLabel">Roll number</label>
                        <input type="text" class="form-control form-control-lg" id="loginId" required autocomplete="username">
                        <div class="invalid-feedback">Please enter your ID.</div>
                    </div>
                    <div class="mb-3">
                        <label for="loginPw" class="form-label fw-semibold">Password</label>
                        <input type="password" class="form-control form-control-lg" id="loginPw" required
                               autocomplete="current-password" minlength="4">
                        <div class="invalid-feedback">Please enter your password (at least 4 characters).</div>
                    </div>
                    <div class="alert alert-info small mb-0 d-none" id="loginNote" role="status">
                        Demo front end only. Sign-in
                        will work once the backend is connected.
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0 px-4 pb-4">
                    <button type="submit" class="btn btn-warning btn-lg fw-semibold w-100">Sign in</button>
                </div>
            </form>
        </div>
    </div>
</div>