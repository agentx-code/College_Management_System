@{
    ViewData["Title"] = "Home Page";
}

<section class="hero text-white position-relative overflow-hidden">
    <div class="container position-relative py-5">
        <div class="row align-items-center gy-5 gx-lg-5 py-lg-4">

            <div class="col-lg-6">
                <p class="eyebrow fade-up d1">College Management System</p>
                <h1 class="hero-title fw-bold fade-up d2">
                    Empowering Minds.<br><span class="text-gold">Building Futures.</span>
                </h1>
                <p class="lead hero-lead fade-up d3">
                    At Nexora Institute of Science &amp; Technology, we believe education goes beyond classrooms.
                    We aim to provide students with a strong academic foundation, practical skills, and
                    opportunities to grow into confident professionals.
                </p>

                <div class="d-flex flex-wrap gap-2 mb-4 fade-up d4">
                    <span class="chip badge rounded-pill">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M22 10 12 5 2 10l10 5 10-5z" />
                            <path d="M6 12v5c3 2 9 2 12 0v-5" />
                        </svg>
                        Academic Excellence
                    </span>
                    <span class="chip badge rounded-pill">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M9 18h6M10 22h4M12 2a7 7 0 0 0-4 12.7c.6.5 1 1.3 1 2.3h6c0-1 .4-1.8 1-2.3A7 7 0 0 0 12 2z" />
                        </svg>
                        Innovation
                    </span>
                    <span class="chip badge rounded-pill">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <rect x="2" y="7" width="20" height="14" rx="2" />
                            <path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2" />
                        </svg>
                        Career Readiness
                    </span>
                </div>

                <div class="d-flex flex-wrap align-items-center gap-3 fade-up d5">
                    <a href="#portal" class="btn btn-warning btn-lg btn-shine fw-semibold px-4">
                        Student Portal <span aria-hidden="true">&rarr;</span>
                    </a>
                    <a asp-action="About" asp-controller="Home" asp-fragment="programs" class="btn btn-outline-light btn-lg px-4">Explore Programs</a>
                    <a href="contact.html"
                       class="link-light link-underline-opacity-25 link-underline-opacity-100-hover fw-medium">
                        Contact Admissions
                    </a>
                </div>
            </div>

            <div class="col-lg-6 fade-up d3">
                <div class="hero-visual position-relative">

                    <div class="ratio ratio-4x3 rounded-4 overflow-hidden shadow-lg hero-frame">
                        <div id="heroSlider" class="carousel slide carousel-fade" data-bs-ride="carousel"
                             data-bs-interval="4500" data-bs-pause="false">
                            <div class="carousel-inner h-100">
                                <div class="carousel-item h-100 active">
                                    <img src="~/assets/images/nexora-building.webp" class="d-block w-100 h-100 object-fit-cover"
                                         alt="Nexora main building with a columned glass entrance">
                                    <div class="carousel-caption text-start"><span>Nexora Main Block</span></div>
                                </div>
                                <div class="carousel-item h-100">
                                    <img src="~/assets/images/study.webp" class="d-block w-100 h-100 object-fit-cover"
                                         alt="Four students reading and studying together on college steps">
                                    <div class="carousel-caption text-start"><span>Learning Together</span></div>
                                </div>
                                <div class="carousel-item h-100">
                                    <img src="~/assets/images/singing.webp" class="d-block w-100 h-100 object-fit-cover"
                                         alt="Group of students playing guitar and flute on a staircase">
                                    <div class="carousel-caption text-start"><span>A Vibrant Campus Community</span></div>
                                </div>
                                <div class="carousel-item h-100">
                                    <img src="~/assets/images/lecture.webp" class="d-block w-100 h-100 object-fit-cover"
                                         alt="Student taking notes in a tiered lecture hall">
                                    <div class="carousel-caption text-start"><span>Modern Lecture Halls</span></div>
                                </div>
                                <div class="carousel-item h-100">
                                    <img src="~/assets/images/courtyard.webp" class="d-block w-100 h-100 object-fit-cover"
                                         alt="Academic block with a green garden walkway">
                                    <div class="carousel-caption text-start"><span>Green Academic Block</span></div>
                                </div>
                                <div class="carousel-item h-100">
                                    <img src="~/assets/images/volleyball.webp" class="d-block w-100 h-100 object-fit-cover"
                                         alt="Students playing volleyball on the sports court">
                                    <div class="carousel-caption text-start"><span>Sports and Recreation</span></div>
                                </div>
                            </div>
                            <button class="carousel-control-prev" type="button" data-bs-target="#heroSlider" data-bs-slide="prev">
                                <span class="carousel-control-prev-icon" aria-hidden="true"></span><span class="visually-hidden">Previous</span>
                            </button>
                            <button class="carousel-control-next" type="button" data-bs-target="#heroSlider" data-bs-slide="next">
                                <span class="carousel-control-next-icon" aria-hidden="true"></span><span class="visually-hidden">Next</span>
                            </button>
                        </div>
                    </div>

                    <div class="float-badge bg-white rounded-4 shadow d-none d-sm-flex align-items-center gap-3 p-2 pe-3">
                        <img src="~/assets/images/graduates.webp" class="rounded-circle object-fit-cover" width="52" height="52"
                             alt="Graduates throwing caps in the air">
                        <div class="lh-sm">
                            <div class="fw-bold small text-navy">Student Success</div>
                            <div class="text-secondary badge-text">Academic, personal and professional growth</div>
                        </div>
                    </div>

                    <div class="welcome-card bg-white rounded-4 shadow-lg p-4">
                        <h2 class="h5 fw-bold text-navy mb-2">Welcome to Nexora</h2>
                        <p class="mb-0 small text-secondary">
                            Discover a learning environment that brings together quality education, modern technology,
                            experienced faculty, and a vibrant campus community. Our digital campus portal makes academic
                            information and essential student services easier to access.
                        </p>
                    </div>

                </div>
            </div>

        </div>
    </div>
</section>

<!-- ================= KEY MODULES + PORTAL LOGIN ================= -->
<section class="py-5 py-lg-6" id="modules">
    <div class="container">
        <div class="row g-4 g-xl-5">
            <div class="col-lg-9">
                <div class="section-head reveal mb-4 mb-lg-5">
                    <p class="eyebrow mb-2">What the system offers</p>
                    <h2 class="section-title text-navy">Our Key Modules</h2>
                </div>
                <div class="row row-cols-2 row-cols-md-3 row-cols-xl-4 g-3">
                    <div class="col">
                        <a href="services.html#admissions" class="module-card card h-100 text-decoration-none reveal"
                           style="--i:0">
                            <div class="card-body p-3 p-xl-4">
                                <span class="icon-box mb-3"><i class="bi bi-mortarboard"></i></span>
                                <h3 class="h6 fw-bold text-navy mb-1">Admissions</h3>
                                <p class="small text-secondary mb-0">Online form, document verification and enrollment.</p>
                            </div>
                        </a>
                    </div>
                    <div class="col">
                        <a href="services.html#attendance" class="module-card card h-100 text-decoration-none reveal"
                           style="--i:1">
                            <div class="card-body p-3 p-xl-4">
                                <span class="icon-box mb-3"><i class="bi bi-calendar-check"></i></span>
                                <h3 class="h6 fw-bold text-navy mb-1">Attendance</h3>
                                <p class="small text-secondary mb-0">Track attendance for students and staff.</p>
                            </div>
                        </a>
                    </div>
                    <div class="col">
                        <a href="services.html#exams" class="module-card card h-100 text-decoration-none reveal" style="--i:2">
                            <div class="card-body p-3 p-xl-4">
                                <span class="icon-box mb-3"><i class="bi bi-file-earmark-text"></i></span>
                                <h3 class="h6 fw-bold text-navy mb-1">Exams &amp; Results</h3>
                                <p class="small text-secondary mb-0">Manage exams, marks and generate results.</p>
                            </div>
                        </a>
                    </div>
                    <div class="col">
                        <a href="services.html#fees" class="module-card card h-100 text-decoration-none reveal" style="--i:3">
                            <div class="card-body p-3 p-xl-4">
                                <span class="icon-box mb-3"><i class="bi bi-currency-rupee"></i></span>
                                <h3 class="h6 fw-bold text-navy mb-1">Fees &amp; Payments</h3>
                                <p class="small text-secondary mb-0">View dues, pay online and get receipts.</p>
                            </div>
                        </a>
                    </div>
                    <div class="col">
                        <a href="services.html#campus" class="module-card card h-100 text-decoration-none reveal" style="--i:0">
                            <div class="card-body p-3 p-xl-4">
                                <span class="icon-box mb-3"><i class="bi bi-book"></i></span>
                                <h3 class="h6 fw-bold text-navy mb-1">Library</h3>
                                <p class="small text-secondary mb-0">Manage books, issue/return and track usage.</p>
                            </div>
                        </a>
                    </div>
                    <div class="col">
                        <a href="services.html#campus" class="module-card card h-100 text-decoration-none reveal" style="--i:1">
                            <div class="card-body p-3 p-xl-4">
                                <span class="icon-box mb-3"><i class="bi bi-building"></i></span>
                                <h3 class="h6 fw-bold text-navy mb-1">Hostel</h3>
                                <p class="small text-secondary mb-0">Room allocation, mess and hostel management.</p>
                            </div>
                        </a>
                    </div>
                    <div class="col">
                        <a href="services.html#roles" class="module-card card h-100 text-decoration-none reveal" style="--i:2">
                            <div class="card-body p-3 p-xl-4">
                                <span class="icon-box mb-3"><i class="bi bi-person-lines-fill"></i></span>
                                <h3 class="h6 fw-bold text-navy mb-1">Student Portal</h3>
                                <p class="small text-secondary mb-0">Check attendance, results, fees, notices and more.</p>
                            </div>
                        </a>
                    </div>
                    <div class="col">
                        <a href="services.html#roles" class="module-card card h-100 text-decoration-none reveal" style="--i:3">
                            <div class="card-body p-3 p-xl-4">
                                <span class="icon-box mb-3"><i class="bi bi-easel"></i></span>
                                <h3 class="h6 fw-bold text-navy mb-1">Teacher Portal</h3>
                                <p class="small text-secondary mb-0">Mark attendance, upload marks, manage classes.</p>
                            </div>
                        </a>
                    </div>
                    <div class="col">
                        <a href="services.html#roles" class="module-card card h-100 text-decoration-none reveal" style="--i:0">
                            <div class="card-body p-3 p-xl-4">
                                <span class="icon-box mb-3"><i class="bi bi-people"></i></span>
                                <h3 class="h6 fw-bold text-navy mb-1">Parent Portal</h3>
                                <p class="small text-secondary mb-0">Stay updated with student progress.</p>
                            </div>
                        </a>
                    </div>
                    <div class="col">
                        <a href="services.html#roles" class="module-card card h-100 text-decoration-none reveal" style="--i:1">
                            <div class="card-body p-3 p-xl-4">
                                <span class="icon-box mb-3"><i class="bi bi-gear"></i></span>
                                <h3 class="h6 fw-bold text-navy mb-1">Admin Panel</h3>
                                <p class="small text-secondary mb-0">Full control over all modules and users.</p>
                            </div>
                        </a>
                    </div>
                    <div class="col">
                        <a href="services.html#exams" class="module-card card h-100 text-decoration-none reveal" style="--i:2">
                            <div class="card-body p-3 p-xl-4">
                                <span class="icon-box mb-3"><i class="bi bi-shield-check"></i></span>
                                <h3 class="h6 fw-bold text-navy mb-1">Examination Cell</h3>
                                <p class="small text-secondary mb-0">Conduct exams, manage schedules and papers.</p>
                            </div>
                        </a>
                    </div>
                    <div class="col">
                        <a href="services.html#reports" class="module-card card h-100 text-decoration-none reveal"
                           style="--i:3">
                            <div class="card-body p-3 p-xl-4">
                                <span class="icon-box mb-3"><i class="bi bi-bar-chart-line"></i></span>
                                <h3 class="h6 fw-bold text-navy mb-1">Reports &amp; Analytics</h3>
                                <p class="small text-secondary mb-0">Get insights with custom reports.</p>
                            </div>
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-lg-3" id="portal">
                <div class="portal-card rounded-4 p-4 text-white reveal reveal-right">
                    <h2 class="h4 fw-bold mb-1" style="font-family:'Playfair Display',serif">Portal Login</h2>
                    <div class="gold-rule mb-3"></div>
                    <p class="small mb-3 text-white-50">Select your role to continue</p>
                    <div class="d-grid gap-2">
                        <button type="button" class="role-btn btn w-100 d-flex align-items-center gap-3 text-start text-white"
                                data-bs-toggle="modal" data-bs-target="#loginModal" data-role="Student">
                            <i class="bi bi-mortarboard-fill fs-5"></i><span class="fw-semibold flex-grow-1">Student</span><i class="bi bi-chevron-right"></i>
                        </button>
                        <button type="button" class="role-btn btn w-100 d-flex align-items-center gap-3 text-start text-white"
                                data-bs-toggle="modal" data-bs-target="#loginModal" data-role="Teacher">
                            <i class="bi bi-person-workspace fs-5"></i><span class="fw-semibold flex-grow-1">Teacher</span><i class="bi bi-chevron-right"></i>
                        </button>
                        <button type="button" class="role-btn btn w-100 d-flex align-items-center gap-3 text-start text-white"
                                data-bs-toggle="modal" data-bs-target="#loginModal" data-role="Parent">
                            <i class="bi bi-people-fill fs-5"></i><span class="fw-semibold flex-grow-1">Parent</span><i class="bi bi-chevron-right"></i>
                        </button>
                        <button type="button" class="role-btn btn w-100 d-flex align-items-center gap-3 text-start text-white"
                                data-bs-toggle="modal" data-bs-target="#loginModal" data-role="Admin">
                            <i class="bi bi-gear-fill fs-5"></i><span class="fw-semibold flex-grow-1">Admin</span><i class="bi bi-chevron-right"></i>
                        </button>
                    </div>
                    <p class="small text-center text-white-50 mt-4 mb-0">Your Campus &bull; Our Responsibility</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ================= WHY CHOOSE ================= -->
