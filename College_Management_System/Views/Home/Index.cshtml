                            entrepreneurship.
                        </p>
                    </div>
                </div>
            </div>
        </div>
        <div class="text-center mt-4 reveal">
            <a href="about.html#programs"
               class="btn btn-outline-primary-nx px-4">Explore Programs <i class="bi bi-arrow-right ms-1"></i></a>
        </div>
    </div>
</section>

